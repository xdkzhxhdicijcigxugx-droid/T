-- 1. คลังข้อความสแปมกวนตีน
local trollMessages = {
   "😏 [โฮคาเงะสายป่วน]: ถึงหน้าตาจะไม่เหมือนพระเอก แต่เวลากินหมูกระทะผมสู้ตายนะครับ!",
   "🙄 [โฮคาเงะสายป่วน]: ที่เงียบไม่ใช่เพราะหยิ่ง... แต่ขี้เกียจพิมพ์ เม้นท์เยอะเจ็บนิ้วเว้ย!",
   "💸 [โฮคาเงะสายป่วน]: วิ่งหนีผีก็เหนื่อยแล้ว ยังต้องมาวิ่งหนีความจนอีก ชีวิตมันร้าวราน!",
   "🤡 [โฮคาเงะสายป่วน]: ใครเห็นข้อความนี้ขอให้หน้าตาดีเหมือนผม แต่ถ้าไม่อ่านขอให้โดนหวยกิน!",
   "⚡ [โฮคาเงะสายป่วน]: หลบหน่อย พระเอกเดินดินจะเดิน แค่มาเดินเล่นเฉยๆ ไม่ได้จะมาเท่!"
}

SpamTab:CreateButton({
   Name = "📢 ส่งข้อความกวนตีนเข้าแชทเซิร์ฟ",
   Callback = function()
      local msg = trollMessages[math.random(1, #trollMessages)]
      local success = pcall(function()
         game:GetService("TextChatService").TextChannels.RBXGeneral:SendAsync(msg)
      end)
      if not success then
         local ReplicatedStorage = game:GetService("ReplicatedStorage")
         local chatRemote = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
         if chatRemote and chatRemote:FindFirstChild("SayMessageRequest") then
             chatRemote.SayMessageRequest:FireServer(msg, "All")
         end
      end
      Rayfield:Notify({Title = "ส่งความกวนแล้ว!", Content = "ยิงข้อความปั่นใส่แชทเรียบร้อย", Duration = 3})
   end,
})

-- 2. โหมดวิ่งหนีแบบโอเวอร์แอคติ้ง
TrollTab:CreateToggle({
   Name = "🏃‍♂️ โหมดวิ่งหนีแบบโดนผีไล่ (WalkSpeed 50)",
   CurrentValue = false,
   Callback = function(v)
      local char = game.Players.LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
         char.Humanoid.WalkSpeed = v and 50 or 16
         Rayfield:Notify({Title = "ปรับความเร็ว", Content = v and "เปิดโหมดวิ่งหนีตับแล่บ!" or "กลับความเร็วปกติแล้ว", Duration = 3})
      end
   end,
})

-- โหมดกระโดดสูงข้ามตึก
TrollTab:CreateToggle({
   Name = "🦘 โหมดกระโดดหนีความจน (JumpPower สูงปรี้ด)",
   CurrentValue = false,
   Callback = function(v)
      local char = game.Players.LocalPlayer.Character
      if char and char:FindFirstChild("Humanoid") then
         char.Humanoid.JumpPower = v and 150 or 50
         Rayfield:Notify({Title = "พลังกระโดด", Content = v and "เปิดโหมดจิงโจ้ป่วนเมือง!" or "กลับสภาวะปกติ", Duration = 3})
      end
   end,
})

-- 3. เสกป้ายลอยฟ้าหรือเอฟเฟกต์กวนๆ
ChaosTab:CreateButton({
   Name = "✨ ปล่อยออร่าคนหล่อเก๊กซิม",
   Callback = function()
      local char = game.Players.LocalPlayer.Character
      if char and char:FindFirstChild("HumanoidRootPart") then
         local p = Instance.new("ParticleEmitter")
         p.Parent = char.HumanoidRootPart
         p.Texture = "rbxassetid://603109099" 
         p.Rate = 50
         p.Speed = NumberRange.new(5, 10)
         Rayfield:Notify({Title = "ออร่าทำงาน!", Content = "ปล่อยแสงประกายความกวนรอบตัวแล้ว", Duration = 3})
         task.wait(5)
         p:Destroy()
      end
   end,
})

